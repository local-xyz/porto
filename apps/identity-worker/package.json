{
  "name": "identity-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:apps && pnpm build:assets",
    "build:apps": "VITE_DEFAULT_ENV=stg VITE_DIALOG_HOST=https://id-staging.localprotocol.xyz/dialog/ pnpm --filter id build && VITE_DEFAULT_ENV=stg pnpm --filter dialog build",
    "build:assets": "tsx scripts/prepare-assets.ts",
    "build:types": "wrangler types --include-runtime=false",
    "check:types": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.45.3"
  }
}
