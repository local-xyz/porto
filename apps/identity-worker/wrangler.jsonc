{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "c814b33642103450ac87d05183f14a1d",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/assets",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-10",
  "main": "src/index.ts",
  "name": "localprotocol-identity-staging",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "preview_urls": true,
  "workers_dev": true
}
