NODE_ENV="development"
ENVIRONMENT="local"

# `/onramp` route: disabled by default, sandbox only
ONRAMP_ENABLED=false
ONRAMP_SANDBOX=true
ONRAMP_RELAY_URL=https://relay-staging.localprotocol.xyz
ONRAMP_CHAIN_ID=84532
ONRAMP_DESTINATION_NETWORK=base
ONRAMP_ALLOWED_ORIGINS=https://id-staging.localprotocol.xyz
CB_API_KEY_ID=
CB_API_KEY_SECRET=
ONRAMP_SECRET=

# `/verify` route
VERIFY_CONFIG_URL=https://raw.githubusercontent.com/MetaMask/eth-phishing-detect/refs/heads/main/src/config.json
